<html>
<head>
<base href="{HTMLURL}">
<link rel="stylesheet" href="style.css">
<title>{CHATNAME}</title>
<SCRIPT LANGUAGE="JavaScript" src="chat.js" type="text/javascript">
</SCRIPT>
<SCRIPT LANGUAGE="JavaScript">
	cgi="{CGI}";
</SCRIPT>
</head>
<body id="body" marginwidth=36 leftmargin=36>

<div align="center">
	<br>
	<img src="/@@INSTALL_PREFIX@@/images/gtchat_logo.png" border=0>
	<br><br><br>
</div>


<div id="headertext">
	<br>
	<br>
{NEWS}
	<br>
</div>

<table border=0 width=100% cellspacing=0 id="lines"><tr><td>  <!-- Netscape compatibility -->

<table border=0 width=100% cellspacing=1>
<tr>
	<th>Create new chat account</th>
</tr>
<tr id="table2"><td><table>
	<tr>
		<td colspan=2>You must fill in the correct e-mail and birth date because you need them in case you forget your password. Your birth date <b>cannot be used</b> for anything else, it is saved encrypted like your password.</td>
	</tr>
	<tr>
		<td colspan=2><a href="javascript:showAllUsers()">Here</a> you can see which nick names are already in use.</td>
	</tr>
	<tr>
		<td colspan=2>&nbsp;</td>
	</tr>
	<form method=POST action="{CGI}&action=register2">
{ROWS}
	</form>
</table></td></tr>
</table>

</td></tr></table>  <!-- Netscape compatibility -->

<div align=center id="headertext">
	GTChat 0.93 &copy; 2001 by <a href="http://www.gtchat.de/" id="stdlink" target="_blank">Wladimir Palant</a>
</div>

</body>
</html>
