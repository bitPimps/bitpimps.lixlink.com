<html>
<head>
<base href="{HTMLURL}">
<link rel="stylesheet" href="style.css">
<title>{CHATNAME}</title>
<SCRIPT LANGUAGE="JavaScript" src="chat.js" type="text/javascript">
</SCRIPT>
<SCRIPT LANGUAGE="JavaScript">
	cgi="{CGI}";
</SCRIPT>
</head>
<body id="body" marginwidth=36 leftmargin=36>

<div align="center">
	<br>
	<img src="/@@INSTALL_PREFIX@@/images/gtchat_logo.png" border=0>
	<br><br>
</div>

<div id="headertext">
	<br>
	<br>
	@@WELCOME_MESSAGE@@<br>
	If you have problems using the chat, read the <a href="faq.html" id=stdlink target="_blank">FAQ</a><br>
	<br>
{NEWS}
	<br>
</div>

<table border=0 width=100% cellspacing=0 cellpadding=10>
<tr>
	<td width=70% valign=top>

<table border=0 width=100% cellspacing=0 id="lines"><tr><td>  <!-- Netscape compatibility -->

<table border=0 width=100% cellspacing=1>
<tr>
	<th>User Login</th>
</tr>
<tr id="table2"><td><table>
<tr>
	<td colspan=2>No permanent name for the chat yet? You can register <a href="{CGI}&action=register">here</a>!</td>
</tr>
<tr>
	<td colspan=2>&nbsp;</td>
</tr>
<form method=POST action="{CGI}&action=frames" target="_top">
{ROWS}
</form>
<tr>
	<td colspan=2 align=center id="smalltext">
		<a href="javascript:showReminder()">Forgot your password? Click here!</a>
	</td>
</tr>
</table></td></tr>
</table>

</td></tr></table>  <!-- Netscape compatibility -->

	</td>
	<td width=30% valign=top>

<table border=0 width=100% cellspacing=0 id="lines"><tr><td>  <!-- Netscape compatibility -->

<table border=0 width=100% cellspacing=1>
<tr>
	<th>
{COUNT}
user(s) online</th>
</tr>
{USERS}
</table>	
	</td>
</tr>
</table>

</td></tr></table>  <!-- Netscape compatibility -->

<div align=center id="headertext">
	GTChat 0.93 &copy; 2001 by <a href="http://www.gtchat.de/" id="stdlink" target="_blank">Wladimir Palant</a>
</div>

</body>
</html>
