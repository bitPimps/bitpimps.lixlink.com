#
# Table structure for table 'phpChat_msg'
#

CREATE TABLE phpChat_msg (
   message_id int(10) unsigned DEFAULT '0' NOT NULL auto_increment,
   timestamp int(11) DEFAULT '0' NOT NULL,
   session_id char(32) NOT NULL,
   message char(255) NOT NULL,
   PRIMARY KEY (message_id),
   KEY timestamp (timestamp),
   KEY session_id (session_id)
);

#
# Table structure for table 'phpChat_nicklist'
#

CREATE TABLE phpChat_nicklist (
   nick varchar(32) NOT NULL,
   channel varchar(32) NOT NULL,
   session_id varchar(32) NOT NULL
);

#
# Table structure for table 'phpChat_session'
#

CREATE TABLE phpChat_session (
   session_id char(32) DEFAULT '0' NOT NULL,
   nick char(32) NOT NULL,
   last_access int(11),
   PRIMARY KEY (session_id)
);

